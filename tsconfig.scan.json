{
	"compilerOptions": {
		"allowJs": false,
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"jsx": "preserve",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist", "reports", "report/user-report/src", "tests"]
}
