    "./config": "./config.js",
    "./main": "./main.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.2",
    "minimatch": "^9.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remeda": "^2.50.0",
    "styled-components": "^6.6.0",
    "ts-morph": "^24.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "scripts": {
    "test": "vitest run",
    "overview": "node bin/follow-architecture.js --overview architecture-overview.html"
  },
  "devDependencies": {
