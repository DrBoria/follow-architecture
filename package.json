{
  "name": "@md-code/follow-architecture",
  "version": "0.1.1",
  "description": "ESLint rule + CLI that enforces a declarative architecture: where files may live, what they may be named, and what they may contain.",
  "license": "MIT",
  "main": "plugin.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "follow-architecture": "bin/follow-architecture.js"
  },
  "files": [
    "plugin.js",
    "config.js",
    "main.js",
    "utils.js",
    "report.js",
    "ast.js",
    "entities",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": "./plugin.js",
    "./plugin": "./plugin.js",
    "./config": "./config.js",
    "./main": "./main.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.0",
    "remeda": "^2.50.0",
    "minimatch": "^9.0.4",
    "ts-morph": "^24.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "architecture",
    "typescript"
  ]
}
