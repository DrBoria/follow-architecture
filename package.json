  "description": "ESLint rule + CLI that enforces a declarative architecture: where files may live, what they may be named, and what they may contain.",
  "license": "Apache-2.0",
  "author": "DrBoria <dr.boria@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrBoria/follow-architecture.git"
  },
  "bugs": {
    "url": "https://github.com/DrBoria/follow-architecture/issues"
  },
  "homepage": "https://github.com/DrBoria/follow-architecture#readme",
  "main": "plugin.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "follow-architecture": "bin/follow-architecture.js"
  },
  "files": [
    "plugin.js",
    "config.js",
    "main.js",
    "aliases.js",
    "args.js",
    "ast",
    "pipeline.js",
    "invariants",
    "nodes",
    "code-roles",
    "entities",
