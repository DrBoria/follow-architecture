{
  "name": "@md-code/follow-architecture",
  "version": "0.2.0-beta.1",
  "description": "ESLint rule + CLI that enforces a declarative architecture: where files may live, what they may be named, and what they may contain.",
  "license": "Apache-2.0",
  "author": "DrBoria <dr.boria@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrBoria/follow-architecture.git"
  },
  "bugs": {
    "url": "https://github.com/DrBoria/follow-architecture/issues"
  },
  "homepage": "https://github.com/DrBoria/follow-architecture#readme",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "follow-architecture": "dist/bin/follow-architecture.js"
  },
  "files": [
    "dist/",
    "report/user-report/src/",
    "report/user-report/shared/",
    "report/errorTypes/vocabulary/",
    "entities/operators.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js",
    "./config": "./dist/config.js",
    "./main": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.2",
    "minimatch": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remeda": "^2.50.0",
    "styled-components": "^6.6.0",
    "stylis": "^4.4.0",
    "tailwindcss": "^3.4.0",
    "ts-morph": "^24.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "overview": "node dist/bin/follow-architecture.js --overview architecture-overview.html",
    "prepublishOnly": "pnpm build && pnpm test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@md-code/component-uniqueness": "file:../component-uniqueness",
    "@md-code/entities-uniqueness": "file:../entities-uniqueness",
    "@md-code/utils-uniqueness": "file:../utils-uniqueness",
    "@types/node": "^26.6.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5.5",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "architecture",
    "typescript"
  ]
}
