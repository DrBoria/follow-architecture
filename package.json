{
  "name": "@md-code/follow-architecture",
  "version": "0.1.0",
  "description": "ESLint rule + CLI that enforces the vertical-slice architecture: every slice has a .resource.ts CRUD binding, every .rm.ts imports and calls it, and nothing bypasses it.",
  "license": "MIT",
  "main": "config.js",
  "bin": {
    "md-code-follow-architecture": "bin/follow-architecture.js"
  },
  "files": [
    "config.js",
    "main.js",
    "utils.js",
    "report.js",
    "ast.js",
    "entities",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": "./config.js",
    "./config": "./config.js",
    "./main": "./main.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "remeda": "^2.50.0",
    "minimatch": "^9.0.4",
    "ts-morph": "^24.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "architecture",
    "vertical-slice",
    "fhir",
    "typescript"
  ]
}
